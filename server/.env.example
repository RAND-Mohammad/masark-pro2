# Server-side only. Set this secret in Replit Secrets or the backend environment.
# Never prefix an AI key with EXPO_PUBLIC_ or bundle it in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Required for account erasure and server-side admin tasks. Never expose in Expo.
SUPABASE_SERVICE_ROLE_KEY=
# Shared server-side key; CV analysis, interview generation/evaluation, and career chat
# run separately, and each feature asks for its own user consent.
GROQ_API_KEY=
GROQ_CV_MODEL=openai/gpt-oss-120b
GROQ_INTERVIEW_MODEL=openai/gpt-oss-20b
GROQ_CAREER_CHAT_MODEL=openai/gpt-oss-120b

# مفتاح الوظائف للسيرفر فقط، كل وحدة تضيف مفتاحها عندها.
HEADCOUNT_API_KEY=
